#!/usr/bin/bash
# What a new Yakuake tab runs (its Konsole profile's command, set by
# plasma/yakuake/build.py): the terminal launcher (agents/launcher: a prompt,
# the provider and folder, every session; it becomes what it starts), or Claude
# Code in ~/system where the launcher isn't installed; a plain shell when the
# tab was opened with --shell (Meta+Shift+N), or the given command with
# --run COMMAND (e.g. yakuake-business-tab, machine-only).
# Yakuake can't pick a profile per tab, so --shell and --run leave the command
# in a flag for the next tab, then open one through the KWin script's "New
# Yakuake Tab" shortcut, so it avoids fullscreen monitors like Meta+N does.
flag=${XDG_RUNTIME_DIR:-/tmp}/yakuake-next-tab

case "${1:-}" in
--shell) next=bash ;;
--run) next=${2:?--run needs a command} ;;
esac
if [ -n "${next:-}" ]; then
    printf '%s' "$next" >"$flag"
    exec qdbus-qt6 org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut "New Yakuake Tab"
fi

# Only a fresh flag counts: an old one is left from a tab that never opened
if [ -n "$(find "$flag" -newermt '-10 seconds' 2>/dev/null)" ]; then
    next=$(cat "$flag")
fi
rm -f "$flag"
[ -n "${next:-}" ] && exec bash -c "$next"
launcher=$HOME/.local/bin/levves-launcher
[ -x "$launcher" ] && exec "$launcher"
cd ~/system && exec claude
